<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8" />
    <title>Charm</title>
    <link rel="stylesheet" href="style.css">
    <link rel="stylesheet" href="loader.css">
    <script>
        light = localStorage.getItem("light") == "true";
        if (light) {
            document.documentElement.classList.add('light-root')
        }
    </script>
</head>

<body class="grid-bg">
    <script>
        projects = "<%= projects %>".split(",");
    </script>
    <button id="darkmode-switch">X</button>
    <div class="main-container">
        <div class="sidebar">
            <h2>Charm</h2>

            <div id="main-view">
                <div class="input-field-row">
                    <div class="input-field">
                        <label for="start-date-input">START DATE*</label>
                        <input id="start-date-input" type="date" value="<%= prefill.start %>">
                        <p id="start-date-input-error"></p>
                    </div>
                    <div class="input-field">
                        <label for="end-date-input">END DATE</label>
                        <input id="end-date-input" type="date" value="<%= prefill.end %>">
                    </div>
                </div>

                <div class="input-field">
                    <label for="repo-input">GITHUB REPOSITORY</label>
                    <input autocomplete="off" autocorrect="off" type="url" id="repo-input" value="<%= prefill.repo %>">
                    <p id="repo-input-error"></p>
                </div>

                <div class="input-field">
                    <label for="token-input">HACKATIME TOKEN*</label>
                    <div class="input-field-row">
                        <input autocomplete="off" autocorrect="off" type="text" id="token-input">

                        <% if (oauthUid) { %>
                        <button id="oauth-button" onclick="oauthButtonClick();" href="https://hackatime.hackclub.com/oauth/authorize?client_id=<%= oauthUid %>&redirect_uri=<%= root %>callback&response_type=code&scope=profile+read">
                            Self Auth
                        </button>
                        <% } %>
                    </div>
                    <p id="token-input-error"></p>
                </div>
                <label>SELECT HACKATIME PROJECTS</label>
                <div id="project-select">
                </div>
                <button id="view-btn" onclick="viewProjects();" disabled>View</button>
            </div>
        </div>
        <div class="inspect-container">
            <div class="flex-row">
                <div class="inspect-section" id="author-container" style="display: none;">
                    <label>AUTHOR</label>
                    <hr>
                    <div class="flex-row">
                        <img src="" id="author-pfp" class="pfp">
                        <div id="author-loader" class="loader"></div>
                        <div>
                            <span id="author-name"></span>
                            <label id="author-slackid"></label>
                            <a target="_blank" id="author-github" href=""></a>
                        </div>
                    </div>
                </div>
                <div class="inspect-section" id="repo-container" style="display: none;">
                    <label>REPOSITORY</label>
                    <hr>
                    <div class="flex-row">
                        <div id="repo-loader" class="loader"></div>
                        <div>
                            <span id="repo-name"></span>
                            <label id="repo-commits"></label>
                            <label id="repo-error" class="error"></label>
                            <a target="_blank" id="repo-link" href=""></a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="inspect-section" id="graph-section" style="display: none;">
                <label>GRAPH</label><br>
                <div id="graph-y-labels"></div>

                <div id="graph-loader">
                    <div class="loader"></div>
                    <span>
                        Parsing Hackatime data. For large projects this can take up to 20 seconds.
                        <br>
                        <label>Use a narrower date range for faster procssing.</label>
                    </span>
                </div>

                <div id="graph-container">
                    <canvas width="0" height="0" id="graph-canvas"></canvas>
                </div>
            </div>
            <div class="flex-row fit-height">
                <div class="inspect-section" id="hour-graph-container" style="display: none;">
                    <label>HOURS</label>
                    <div id="hour-graph" class="pie-chart"></div>
                    <div id="hour-graph-text" class="pie-chart-text"></div>
                </div>
                <div class="inspect-section" id="commit-type-graph-container" style="display: none;">
                    <label>COMMITS</label>
                    <div id="commit-type-graph" class="pie-chart"></div>
                    <div id="commit-type-graph-text" class="pie-chart-text"></div>
                </div>
            </div>
        </div>
    </div>

    <script src="shared.js"></script>
    <script src="menu.js"></script>
    <script src="graph.js"></script>
</body>

</html>